# Discord Bot Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Required: Your Discord bot token
DISCORD_TOKEN=your_discord_bot_token_here

# Optional: Discord application ID (for slash commands)
DISCORD_APPLICATION_ID=your_application_id_here

# Optional: Default guild ID for testing
DISCORD_GUILD_ID=your_guild_id_here

# Optional: Transport type (stdio or http)
DISCORD_TRANSPORT=stdio

# Optional: Server port (for HTTP transport)
DISCORD_PORT=8080

# Optional: Log level (debug, info, warn, error)
DISCORD_LOG_LEVEL=info

# Optional: Rate limiter settings
RATE_LIMIT_MAX_CONCURRENT=5
RATE_LIMIT_HIGH_THRESHOLD=3
RATE_LIMIT_QUEUE_TIMEOUT=30000

# Optional: Cache TTL settings (in milliseconds)
CACHE_TTL_GUILDS=300000
CACHE_TTL_CHANNELS=120000
CACHE_TTL_ROLES=300000
CACHE_TTL_MEMBERS=60000
